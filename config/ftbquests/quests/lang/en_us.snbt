{
	"chapter.1B0465E0293D763F.chapter_subtitle": [
		"Fortresses, bastions and fire. Ends with Ignis."
	]
	"chapter.1B0465E0293D763F.title": "Chapter 2: The Nether"
	"chapter.558871694C755BB8.chapter_subtitle": [
		"How everything works, one quest at a time."
	]
	"chapter.558871694C755BB8.title": "Getting Started"
	"chapter.764B89D8B2026F83.chapter_subtitle": [
		"Hearthlands, Wildlands and the Frontier. Ends with The Harbinger."
	]
	"chapter.764B89D8B2026F83.title": "Chapter 1: The Overworld"
	"chapter.7F4F1DAF0F1ED786.chapter_subtitle": [
		"The dragon, the cities and the citadel."
	]
	"chapter.7F4F1DAF0F1ED786.title": "Chapter 3: The End"
	"file.0000000000000001.title": "minerpg"
	"quest.11F4C25FDB99D364.quest_desc": [
		"Never take a blow you can roll away from. R, unless you changed it."
		"Mid-roll, nothing can touch you. Rolls recharge over time."
	]
	"quest.11F4C25FDB99D364.quest_subtitle": "Dodge roll"
	"quest.11F4C25FDB99D364.title": "Light on Your Feet"
	"quest.139971D90D5C61AB.quest_desc": [
		"Many spells burn runes. Make them at a Rune Crafting Altar: same materials, more runes than a crafting table."
	]
	"quest.139971D90D5C61AB.quest_subtitle": "Craft runes"
	"quest.139971D90D5C61AB.title": "Stones That Remember"
	"quest.13C628F8E97EDFB1.quest_desc": [
		"Reach &6level 30&r in any of your jobs."
		"At level 30, Smiths, Hunters and Enchanters make the Armory sets from Ignis's upgrade crystals; Smiths reforge to Mythic and Enchanters make endshelves."
		"&7Checked when the job levels up.&r"
	]
	"quest.13C628F8E97EDFB1.quest_subtitle": "Job milestone"
	"quest.13C628F8E97EDFB1.title": "Master"
	"quest.140588183FBEF823.quest_desc": [
		"Open your inventory and press the sword button: spell power, crit, armor, all of it."
	]
	"quest.140588183FBEF823.quest_subtitle": "Your stats screen"
	"quest.140588183FBEF823.title": "Know Thyself"
	"quest.14102C2355F637DA.quest_desc": [
		"Defeat &9The Leviathan&r in its flooded hall. It is untouchable out of the water, so fight it in its element."
		""
		"&7Reward: a map marking an ancient city of the Frontier.&r"
	]
	"quest.14102C2355F637DA.quest_subtitle": "Boss"
	"quest.14102C2355F637DA.title": "Teeth of the Tide"
	"quest.15511B0F8DB55CDA.quest_desc": [
		"This book walks with you from your first night to the edge of the world."
		"Each tab is a chapter. Each quest points at something worth trying, and pays you for it."
		""
		"Press L whenever you are lost."
		"Your &6Adventurer's Handbook&r knows how this world works: races, classes, jobs, zones, loot, parties, and a Field Guide that fills in as you explore. Lost it? A book and a feather make another."
		""
		"Tick the box to begin."
	]
	"quest.15511B0F8DB55CDA.quest_subtitle": "Start here"
	"quest.15511B0F8DB55CDA.title": "Welcome, Traveler"
	"quest.160ED3FACCC66FD9.quest_desc": [
		"Shulkers guard the cities. Their shells make portable chests."
	]
	"quest.160ED3FACCC66FD9.quest_subtitle": "Side task"
	"quest.160ED3FACCC66FD9.title": "Shell Collector"
	"quest.16410072A73C2220.quest_desc": [
		"Targets in a fenced yard. The Archery Artisan sells bows, crossbows, arrows and archer armor."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.16410072A73C2220.quest_subtitle": "Class building"
	"quest.16410072A73C2220.title": "The Archery Range"
	"quest.1683BAA7EE6A9D08.quest_desc": [
		"Craft Eyes of Ender from an ender pearl, blaze powder and your Void Shard. The shard stays in the grid."
		"You need a dozen to wake an End portal (some frames already hold eyes)."
		""
		"&7Reward: a map marking the nearest stronghold.&r"
	]
	"quest.1683BAA7EE6A9D08.quest_subtitle": "Chapter start"
	"quest.1683BAA7EE6A9D08.title": "Eyes of the Void"
	"quest.16E53725EC3775DC.quest_desc": [
		"Dungeon chests keep a share for each of you. No need to race your friends to the loot."
	]
	"quest.16E53725EC3775DC.quest_subtitle": "Personal dungeon chests"
	"quest.16E53725EC3775DC.title": "Yours Alone"
	"quest.18165E933705A224.quest_desc": [
		"Rusted halls under the mountains, still humming. Something there is still awake."
	]
	"quest.18165E933705A224.quest_subtitle": "Frontier"
	"quest.18165E933705A224.title": "The Ancient Factory"
	"quest.1870DB9E3B1A8057.quest_desc": [
		"Alchemists earn experience brewing, crafting runes and potion charms. Brew any potion."
	]
	"quest.1870DB9E3B1A8057.quest_subtitle": "Job starter"
	"quest.1870DB9E3B1A8057.title": "Alchemist"
	"quest.1912871E23D2757E.quest_desc": [
		"Wither skeletons roam the fortress halls. Their skulls are needed if you ever dare summon the Wither."
	]
	"quest.1912871E23D2757E.quest_subtitle": "Side task"
	"quest.1912871E23D2757E.title": "Grim Trophies"
	"quest.1957E4BC9E79A53A.quest_desc": [
		"Defeat &bMaledictus&r, the prisoner who became the prison."
		""
		"&7Reward: a map marking an ancient city of the Frontier.&r"
	]
	"quest.1957E4BC9E79A53A.quest_subtitle": "Boss"
	"quest.1957E4BC9E79A53A.title": "The Cursed Warden"
	"quest.1A456EDA90491257.quest_desc": [
		"Tome in its spell book slot. A weapon of the same class in hand."
		"Now cast: the spell keys are shown on your hotbar."
	]
	"quest.1A456EDA90491257.quest_subtitle": "Equip your tome, cast a spell"
	"quest.1A456EDA90491257.title": "Bound to the Book"
	"quest.1A5DB36593187D79.quest_desc": [
		"Smelt the debris, mix it with gold and forge your first netherite ingot."
	]
	"quest.1A5DB36593187D79.title": "Netherite in Hand"
	"quest.1BACA375DF555AD6.quest_desc": [
		"A forge built of blackstone and lava, guarded by its own creation."
	]
	"quest.1BACA375DF555AD6.title": "The Soul Blacksmith"
	"quest.1BC9B50E8EB7C872.quest_desc": [
		"Your folk gave you a few small gifts, one drawback and one power."
		""
		"Use your racial power once. V, unless you changed it."
	]
	"quest.1BC9B50E8EB7C872.quest_subtitle": "Your race and its power"
	"quest.1BC9B50E8EB7C872.title": "Who Are You?"
	"quest.1BCB2048A44AC85E.quest_desc": [
		"Trappers speak of black ice where nothing grows. One of them still has a map."
		""
		"&7Reward: a map marking the Frosted Prison.&r"
	]
	"quest.1BCB2048A44AC85E.quest_subtitle": "Map"
	"quest.1BCB2048A44AC85E.title": "Whispers of Ice"
	"quest.1BD38E61C99DC272.quest_desc": [
		"Past the outer islands stand purple cities. Take a gateway and find one."
	]
	"quest.1BD38E61C99DC272.title": "Cities Among the Stars"
	"quest.1C1A258BBB1C69E5.quest_desc": [
		"An Eye of Void finds the ruined citadel. Craft one."
	]
	"quest.1C1A258BBB1C69E5.quest_subtitle": "Side task"
	"quest.1C1A258BBB1C69E5.title": "Eye of the Void"
	"quest.1D4EBCBCFF715BE5.quest_desc": [
		"Gear comes in rarities, each with its own color: Common, Uncommon, Rare, Epic, Mythic. The rarer, the more bonus stats."
		"Gear you do not need goes to a Salvaging Table. Its scraps pay for reforging."
		""
		"Your &eworld tier&r (Ctrl+T to look) sets how tough monsters are and how good the loot is. It starts at Haven and climbs on its own as chapter bosses fall: Venture, Ascent, Summit, Pinnacle. It never goes back."
	]
	"quest.1D4EBCBCFF715BE5.quest_subtitle": "Gear rarity and salvaging"
	"quest.1D4EBCBCFF715BE5.title": "Not All Blades Are Equal"
	"quest.1E4A5E0883A15E45.quest_desc": [
		"Something has nested under the fields. Find a small dungeon and clear out what lives there."
		""
		"&7Reward: a map marking the Amethyst Nest.&r"
	]
	"quest.1E4A5E0883A15E45.quest_subtitle": "Hearthlands"
	"quest.1E4A5E0883A15E45.title": "Cellar Dwellers"
	"quest.1EFEBF71C0647595.quest_desc": [
		"Defeat the &6Ancient Remnant&r in the depths of the pyramid."
		""
		"&7Reward: a map marking an ancient city of the Frontier.&r"
	]
	"quest.1EFEBF71C0647595.quest_subtitle": "Boss"
	"quest.1EFEBF71C0647595.title": "Bones of the Sun King"
	"quest.1FAA931726326BFC.quest_desc": [
		"Towers of blue stone under the waves. Bring water breathing."
	]
	"quest.1FAA931726326BFC.quest_subtitle": "Wildlands"
	"quest.1FAA931726326BFC.title": "The Sunken City"
	"quest.1FF45754B3ADE445.quest_desc": [
		"Farmers earn experience harvesting grown crops and cooking pot meals. Bring in 16 wheat."
	]
	"quest.1FF45754B3ADE445.quest_subtitle": "Job starter"
	"quest.1FF45754B3ADE445.title": "Farmer"
	"quest.20827BF57F7546BE.quest_desc": [
		"Old keeps and piglin donjons dot the wastes. Explore one."
	]
	"quest.20827BF57F7546BE.quest_subtitle": "Side task"
	"quest.20827BF57F7546BE.title": "Keep of Ash"
	"quest.208546346D7B1A57.quest_desc": [
		"Stronger spells are bound at a Spell Binding Table. Every plains village, yours included, keeps one in its gazebo. Or build your own and ring it with bookshelves."
		"Put your tome in and pay in experience levels."
	]
	"quest.208546346D7B1A57.quest_subtitle": "Learn new spells"
	"quest.208546346D7B1A57.title": "The Binding Table"
	"quest.21324AB76EF33990.quest_desc": [
		"A broken fortress drifting at the edge of the void."
	]
	"quest.21324AB76EF33990.title": "The Ruined Citadel"
	"quest.23438309D3EE7ED9.quest_desc": [
		"Some things only a trained hand can &omake&r:"
		"Class gear is made by three trades, by tier: tier 1 at level 10, diamond tier 2 at 20, netherite tier 3 at 25, Armory sets at 30."
		"- &cSmith&r: plate armor and melee weapons (Warrior, Paladin, Berserker, Forcemaster). Reforging to Rare needs Smith 10, Epic 20, Mythic 30."
		"- &2Hunter&r: leather armor, bows, crossbows, spears and quivers (Archer, Rogue)."
		"- &dEnchanter&r: robes, staves, wands and instruments (Wizard, mages, Priest, Bard), and the stronger enchanting shelves: Hellshelf and Seashelf at 10, their upgrades at 20, deep and sculk shelves at 25, endshelves at 30."
		"- &5Alchemist&r: Strong and Long potions at 10, Splash at 15, Lingering at 20."
		""
		"Anyone can &ouse&r these things. Class gear still drops from dungeons and bosses, class merchants sell it, plain bookshelves work for everyone, and a friend with the job can make it for you."
		"Hover over an item to see the job and level that make it."
		"Job experience also comes from the adventure: Smiths from reforging, salvaging and socketing, Enchanters from binding spells and cutting gems, Alchemists from runes and potion charms, Hunters from skinning their kills and working leather, Farmers from the cooking pot."
		"Class merchants buy crafted goods for emeralds: runes, diamond-tier class weapons and pot meals."
	]
	"quest.23438309D3EE7ED9.quest_subtitle": "Crafting gates and job experience"
	"quest.23438309D3EE7ED9.title": "Masters of a Trade"
	"quest.267B5D48DAF1CC15.quest_desc": [
		"Smiths earn experience smelting ingots, crafting tools, weapons and armor, and reforging, salvaging and socketing gear. Craft an iron pickaxe."
	]
	"quest.267B5D48DAF1CC15.quest_subtitle": "Job starter"
	"quest.267B5D48DAF1CC15.title": "Smith"
	"quest.29E79544ED9ADE2F.quest_desc": [
		"Throw an eye and follow it underground to the stronghold and its portal room."
	]
	"quest.29E79544ED9ADE2F.title": "The Stronghold"
	"quest.2C9281C642E70027.quest_desc": [
		"The &aHearthlands&r are the gentle lands: plains, forests, meadows and rivers, with villages, taverns and small dungeons. Learn your class here."
		"Walk the streets of a village to begin."
		""
		"&7Reward: a map marking the nearest small dungeon.&r"
	]
	"quest.2C9281C642E70027.quest_subtitle": "Hearthlands"
	"quest.2C9281C642E70027.title": "The Hearth Road"
	"quest.2D964BD77219E2CA.quest_desc": [
		"With other players online, a killing blow leaves you &cdowned&r instead. You have 60 seconds."
		"A friend holds use (right-click) on you for 3 seconds to pick you up. Heal spells cannot reach the downed: someone has to come to you."
		"You get up with 3 hearts and a short Weakness. Fall again soon and the same timer keeps running."
		"Alone on the server, nobody is coming: you simply die. Lava and the void kill at once."
		"A real death costs you nothing: your things and experience wait in a &6grave&r where you fell. Chat tells you where."
	]
	"quest.2D964BD77219E2CA.quest_subtitle": "Downed and revived"
	"quest.2D964BD77219E2CA.title": "Pick Them Up"
	"quest.2E75B2448D173567.quest_desc": [
		"Fill the frame and jump in. There is no coming back until the dragon falls, or you die."
	]
	"quest.2E75B2448D173567.title": "Into the End"
	"quest.303494E14ED1C03B.quest_desc": [
		"Choose who you start as. You get the class tome, a starter weapon, one armor piece, and the runes or arrows it burns."
		""
		"Nothing is final: a second class waits at any Spell Binding Table."
	]
	"quest.303494E14ED1C03B.quest_subtitle": "Your class starter kit"
	"quest.303494E14ED1C03B.title": "Choose Your Calling"
	"quest.311B8E5CCB0CEAB9.quest_desc": [
		"Dark brick bridges cross the lava seas. Find a fortress."
	]
	"quest.311B8E5CCB0CEAB9.title": "Fortress of Flame"
	"quest.320B32FBD74A9EAF.quest_desc": [
		"You can walk anywhere. Two doors need keys:"
		"- &6Nether Sigil&r: from The Harbinger, at the end of the Overworld chapter. Fire will not wake a Nether portal; the sigil will."
		"- &dVoid Shard&r: from Ignis, at the end of the Nether chapter. No Eye of Ender without one."
		"Everyone near a boss when it falls gets their own key."
	]
	"quest.320B32FBD74A9EAF.quest_subtitle": "The Nether Sigil and the Void Shard"
	"quest.320B32FBD74A9EAF.title": "Locked Doors"
	"quest.34BEFE9F912CD9C5.quest_desc": [
		"Deep under the Hearthlands, a sealed chamber holds a suit of armor that is not empty: the &7Ferrous Wroughtnaut&r."
		"Its armor turns most blows. Dodge the axe, then strike its back while it recovers."
		"Optional. Everyone nearby at the kill earns a Wrought Rivet."
	]
	"quest.34BEFE9F912CD9C5.quest_subtitle": "Optional boss"
	"quest.34BEFE9F912CD9C5.title": "The Iron Sentinel"
	"quest.3666625E717DFC13.quest_desc": [
		"Summon and destroy &8the Wither&r with your whole group. Everyone nearby earns an Ashen Skull Shard."
	]
	"quest.3666625E717DFC13.quest_subtitle": "Optional raid"
	"quest.3666625E717DFC13.title": "The Wither"
	"quest.3DFB025E3BBA5CDC.quest_desc": [
		"Defeat &4The Harbinger&r, the factory's iron herald."
		"Everyone nearby at the kill receives a &6Nether Sigil&r: use it on an obsidian frame to open the way to the Nether."
		"The sigil raises your world tier to &eAscent&r. Your reward includes netherite upgrade templates for the next tier and a talent point."
	]
	"quest.3DFB025E3BBA5CDC.quest_subtitle": "Chapter boss"
	"quest.3DFB025E3BBA5CDC.title": "The Harbinger"
	"quest.3E7B599CAC455CBF.quest_desc": [
		"A pyramid half-buried in desert sand, its door sealed with old curses."
	]
	"quest.3E7B599CAC455CBF.quest_subtitle": "Wildlands"
	"quest.3E7B599CAC455CBF.title": "The Cursed Pyramid"
	"quest.3F043D30988BC476.quest_desc": [
		"Press H for the Party HUD: invite your friends and keep their health in sight."
		"Your spells and swings never hurt each other, and kills near a friend teach you both. Heals and buffs reach every player, party or not."
		"In the Members tab, right-click each friend and add them to favorites to see their health frames."
		"Every boss is built for a full party of four. Alone, you will not win. Bring your friends."
		"Your quest book stays your own. When a boss falls, everyone nearby gets their own trophy or key."
	]
	"quest.3F043D30988BC476.quest_subtitle": "Party HUD (H)"
	"quest.3F043D30988BC476.title": "Better Together"
	"quest.3F2D9F92D902836B.quest_desc": [
		"A guard house with weapon racks. The Arms Dealer sells daggers, sickles, axes and armor for Rogues and Warriors."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.3F2D9F92D902836B.quest_subtitle": "Class building"
	"quest.3F2D9F92D902836B.title": "The Barracks"
	"quest.4002DA8DFCA3AC1A.quest_desc": [
		"Masked Umvuthana guard a grove in the savanna. Their chief, &6Umvuthi, the Sunbird&r, calls down sunfire and heals behind his followers."
		"Optional. Everyone nearby at the kill earns a Sunbird Plume."
	]
	"quest.4002DA8DFCA3AC1A.quest_subtitle": "Optional boss"
	"quest.4002DA8DFCA3AC1A.title": "The Sunbird's Court"
	"quest.4006A822FCE741F9.quest_desc": [
		"A fortress of black ice where something was locked away on purpose."
	]
	"quest.4006A822FCE741F9.quest_subtitle": "Wildlands"
	"quest.4006A822FCE741F9.title": "The Frosted Prison"
	"quest.404575A89AD631AE.quest_desc": [
		"An Eye of Monstrous leads to the soul blacksmith's forge. Craft one."
	]
	"quest.404575A89AD631AE.quest_subtitle": "Side task"
	"quest.404575A89AD631AE.title": "Eye of Fury"
	"quest.40678BD3902A909A.quest_desc": [
		"Reach &6level 20&r in any of your jobs."
		"At level 20, Smiths, Hunters and Enchanters make diamond class gear; Smiths reforge to Epic, Enchanters make the upgraded hell and sea shelves, and Alchemists brew Lingering potions."
		"&7Checked when the job levels up.&r"
	]
	"quest.40678BD3902A909A.quest_subtitle": "Job milestone"
	"quest.40678BD3902A909A.title": "Expert"
	"quest.409FB0BE8F2205F1.quest_desc": [
		"Every kill teaches you something. Press N and spend your first talent point."
		"Friends within 200 blocks learn from your kills too."
		"Kills earn up to 9 points. The last 4 come from the great chapter bosses."
	]
	"quest.409FB0BE8F2205F1.quest_subtitle": "Spend a talent point"
	"quest.409FB0BE8F2205F1.title": "A Point to Spend"
	"quest.42582C31630D2A7E.quest_desc": [
		"An Eye of Desert points the way to the cursed pyramid. Craft one and throw it."
	]
	"quest.42582C31630D2A7E.quest_subtitle": "Side task"
	"quest.42582C31630D2A7E.title": "Eye of the Dunes"
	"quest.4278AAA096D6AA74.quest_desc": [
		"An Eye of Abyss finds the sunken city. Craft one and throw it from a boat."
	]
	"quest.4278AAA096D6AA74.quest_subtitle": "Side task"
	"quest.4278AAA096D6AA74.title": "Eye of the Deep"
	"quest.44A9402B363085DF.quest_desc": [
		"Destroy the crystals and slay the &5Ender Dragon&r. Everyone nearby earns a Dragonscale."
		"With both the Dragonscale and the Citadel Keystone, your world tier rises to &ePinnacle&r."
	]
	"quest.44A9402B363085DF.quest_subtitle": "Boss"
	"quest.44A9402B363085DF.title": "The Last Dragon"
	"quest.47192179145EF3AD.quest_desc": [
		"Piglins hoard gold in huge black fortresses. Find a bastion."
	]
	"quest.47192179145EF3AD.title": "Bastion of Gold"
	"quest.498B6C57012F8D8C.quest_desc": [
		"You start in a plains village. Besides its gazebo, villages can have buildings for the classes, each with its own merchant:"
		"- &dWizard Tower&r: Wizard Merchant (wizards and mages)"
		"- &eSanctuary&r: Monk (paladins and priests)"
		"- &cBarracks&r: Arms Dealer (rogues and warriors)"
		"- &aArchery Range&r: Archery Artisan (archers)"
		"- &6Pub&r: Luthier (bards)"
		"A Jeweler sells rings and necklaces. Not every village has every building: if yours lacks one, the next village may have it."
		"Berserkers and forcemasters have no building of their own; the Arms Dealer and Jeweler serve everyone."
		""
		"Trade once with any of these merchants. Use the emeralds from your calling."
	]
	"quest.498B6C57012F8D8C.quest_subtitle": "Visit the village"
	"quest.498B6C57012F8D8C.title": "Merchants of Every Calling"
	"quest.4C685D602A4CCFA3.quest_desc": [
		"Diggers earn experience digging dirt, sand, gravel and clay. Carry 32 of one."
	]
	"quest.4C685D602A4CCFA3.quest_subtitle": "Job starter"
	"quest.4C685D602A4CCFA3.title": "Digger"
	"quest.4C6920214DBED4FE.quest_desc": [
		"Light a portal with your Nether Sigil and step through. The Nether is hotter and meaner than anything above."
		"Lost your portal? Inside the Nether, normal fire still lights one, so you can always get home."
	]
	"quest.4C6920214DBED4FE.quest_subtitle": "Chapter start"
	"quest.4C6920214DBED4FE.title": "Through the Veil"
	"quest.50C778B21D914B33.quest_desc": [
		"The deep dark keeps its secrets in echo shards. Bring some back, quietly."
	]
	"quest.50C778B21D914B33.quest_subtitle": "Side task"
	"quest.50C778B21D914B33.title": "Echoes Below"
	"quest.50D978A09E750B13.quest_desc": [
		"Reach &6level 10&r in any of your jobs."
		"At level 10, Smiths, Hunters and Enchanters make tier 1 class gear of their kind, Enchanters also the Hellshelf and Seashelf, and Alchemists brew Strong and Long potions."
		"&7Checked when the job levels up.&r"
	]
	"quest.50D978A09E750B13.quest_subtitle": "Job milestone"
	"quest.50D978A09E750B13.title": "Journeyman"
	"quest.516F384D63226205.quest_desc": [
		"A small white chapel. The Monk sells holy weapons, armor and healing runes for Paladins and Priests."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.516F384D63226205.quest_subtitle": "Class building"
	"quest.516F384D63226205.title": "The Sanctuary"
	"quest.5342B109738F0034.quest_desc": [
		"Fishermen avoid one stretch of sea: towers stand under the water there. They marked it for you."
		""
		"&7Reward: a map marking the Sunken City.&r"
	]
	"quest.5342B109738F0034.quest_subtitle": "Map"
	"quest.5342B109738F0034.title": "Whispers of the Tide"
	"quest.540E7EDF83A1ADBE.quest_desc": [
		"Make something only a trained hand can make: class gear as a Smith, Hunter or Enchanter, an enchanting shelf as an Enchanter, or a Strong, Long, Splash or Lingering potion as an Alchemist."
		"Then hand it to a party member who could not make it. That is what trades are for."
	]
	"quest.540E7EDF83A1ADBE.quest_subtitle": "Job milestone"
	"quest.540E7EDF83A1ADBE.title": "Made for a Friend"
	"quest.54854E6D0A86E2C6.quest_desc": [
		"The &cFrontier&r is the extreme: frozen peaks, ice spikes, the deep dark and the deep ocean. The hardest lands of this world."
		"Beat at least one Wildlands boss, then find an ancient city in the deep dark."
		""
		"&7Reward: a map marking the Ancient Factory.&r"
	]
	"quest.54854E6D0A86E2C6.quest_subtitle": "Frontier"
	"quest.54854E6D0A86E2C6.title": "The Frontier"
	"quest.551B4EC7917C7B74.quest_desc": [
		"Defeat the &6Netherite Monstrosity&r. Beating it earns you a talent point."
	]
	"quest.551B4EC7917C7B74.quest_subtitle": "Boss"
	"quest.551B4EC7917C7B74.title": "Forged in Fury"
	"quest.5542D87C1BF085E8.quest_desc": [
		"A lively pub. The Luthier sells lutes and other instruments for Bards."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.5542D87C1BF085E8.quest_subtitle": "Class building"
	"quest.5542D87C1BF085E8.title": "The Bard's Pub"
	"quest.558D7ACBE84CC796.quest_desc": [
		"Blazes guard the fortress. Their rods feed brewing stands and Eyes of Ender alike."
	]
	"quest.558D7ACBE84CC796.title": "Burning Wardens"
	"quest.588CB70442A544B0.quest_desc": [
		"Waystones stand in villages and along the roads. Wake one, and any other waystone can bring you back to it."
		"Each trip costs a little experience: farther costs more."
	]
	"quest.588CB70442A544B0.quest_subtitle": "Fast travel"
	"quest.588CB70442A544B0.title": "Stones of Passage"
	"quest.5912FE33E4E2C70E.quest_desc": [
		"Miners earn experience breaking stone and ores. Mine 16 coal."
	]
	"quest.5912FE33E4E2C70E.quest_subtitle": "Job starter"
	"quest.5912FE33E4E2C70E.title": "Miner"
	"quest.5A29FB8E07307813.quest_desc": [
		"A ring of fire where a fallen knight still waits for challengers."
	]
	"quest.5A29FB8E07307813.title": "The Burning Arena"
	"quest.5A678F41280A7521.quest_desc": [
		"Deep in the Nether, ancient debris resists even lava. Dig some up."
	]
	"quest.5A678F41280A7521.title": "Ancient Debris"
	"quest.5D0D3E3C2B3C0A65.quest_desc": [
		"Press J and join two jobs. Each grows from its own work and pays in coins and perks."
		"Spend &6job coins&r in the same menu on power-ups or a third job. Every level pays a coin; many quests pay more."
		"The quests below show one way into each job."
	]
	"quest.5D0D3E3C2B3C0A65.quest_subtitle": "Jobs menu (J)"
	"quest.5D0D3E3C2B3C0A65.title": "Pick Your Trades"
	"quest.5DDDF61746F073A3.quest_desc": [
		"Nether wart grows in fortress gardens. Every real potion starts with it."
	]
	"quest.5DDDF61746F073A3.quest_subtitle": "Side task"
	"quest.5DDDF61746F073A3.title": "Wart and All"
	"quest.5E38F20E3A481EE5.quest_desc": [
		"Deep in the lush caves, an amethyst nest glows. Its keeper does not like visitors."
	]
	"quest.5E38F20E3A481EE5.quest_subtitle": "Hearthlands"
	"quest.5E38F20E3A481EE5.title": "Glitter in the Deep"
	"quest.5E8BD5E5357754FB.quest_desc": [
		"A tall tower of stone and purple glass. The Wizard Merchant sells staves, wands, robes and runes for Arcane, Fire and Frost Wizards (and mages can buy runes there too)."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.5E8BD5E5357754FB.quest_subtitle": "Class building"
	"quest.5E8BD5E5357754FB.title": "The Wizard Tower"
	"quest.5F0FA75876070FF6.quest_desc": [
		"End ships carry a pair of wings. Claim them."
	]
	"quest.5F0FA75876070FF6.quest_subtitle": "Side task"
	"quest.5F0FA75876070FF6.title": "Wings of the End"
	"quest.608F4956BDD8B0F1.quest_desc": [
		"Some outer islands hold great castles and lighthouses. Explore one."
	]
	"quest.608F4956BDD8B0F1.quest_subtitle": "Side task"
	"quest.608F4956BDD8B0F1.title": "The Castle at the Edge"
	"quest.654D4488C8A8FA77.quest_desc": [
		"Taverns sit along the roads of the Hearthlands. Travelers trade, rest and swap stories there."
		"The map you woke with leads to the nearest one."
	]
	"quest.654D4488C8A8FA77.quest_subtitle": "Hearthlands"
	"quest.654D4488C8A8FA77.title": "A Warm Hearth"
	"quest.6555936DF8BED6FB.quest_desc": [
		"Craft a waystone and set it at your home."
		"The Warp Stone you earn here takes you to any waystone you know, from anywhere, for free. It needs 5 minutes to recover after each use."
	]
	"quest.6555936DF8BED6FB.quest_subtitle": "Side task"
	"quest.6555936DF8BED6FB.title": "A Stone of Your Own"
	"quest.68ADD28694A0A17E.quest_desc": [
		"An Eye of Mech points to the ancient factory. Craft one and follow it."
	]
	"quest.68ADD28694A0A17E.quest_subtitle": "Side task"
	"quest.68ADD28694A0A17E.title": "Eye of Iron"
	"quest.691EA646A3AD516D.quest_desc": [
		"Good iron makes good gear. Stock up for your first upgrades."
	]
	"quest.691EA646A3AD516D.quest_subtitle": "Side task"
	"quest.691EA646A3AD516D.title": "Ironclad"
	"quest.6B54BC29B3B37827.quest_desc": [
		"Defeat the &5Ender Guardian&r, last warden of the citadel. Beating it earns you your last talent point."
		"With both the Citadel Keystone and the Dragonscale, your world tier rises to &ePinnacle&r."
	]
	"quest.6B54BC29B3B37827.quest_subtitle": "Chapter boss"
	"quest.6B54BC29B3B37827.title": "Guardian of the Void"
	"quest.6C811E0AFCFDD19B.quest_desc": [
		"Enchanters earn experience at the enchanting table, the Spell Binding Table and the gem cutting table. Enchant any item."
	]
	"quest.6C811E0AFCFDD19B.quest_subtitle": "Job starter"
	"quest.6C811E0AFCFDD19B.title": "Enchanter"
	"quest.7107848BAFC6BF09.quest_desc": [
		"Builders earn experience for every block they place. Place one to start."
	]
	"quest.7107848BAFC6BF09.quest_subtitle": "Job starter"
	"quest.7107848BAFC6BF09.title": "Builder"
	"quest.710AD64B960DC726.quest_desc": [
		"The &6Wildlands&r are the harsh lands: deserts, jungles, swamps, taigas, dark forests and open sea. Big dungeons and ruins hide there, and monsters hit harder."
		"Explore one of the great dungeons of the wild."
	]
	"quest.710AD64B960DC726.quest_subtitle": "Wildlands"
	"quest.710AD64B960DC726.title": "Into the Wildlands"
	"quest.71ED147E96C3CDB4.quest_desc": [
		"Defeat &cIgnis&r, the burning champion."
		"Everyone nearby at the kill receives a &dVoid Shard&r. Eyes of Ender need it, and it is never used up."
		"The shard raises your world tier to &eSummit&r. Your reward includes a talent point and a book of &bSpell Infinity&r: put it on your weapon at an anvil and your spells stop using runes."
	]
	"quest.71ED147E96C3CDB4.quest_subtitle": "Chapter boss"
	"quest.71ED147E96C3CDB4.title": "Ignis"
	"quest.73292E754A800B8D.quest_desc": [
		"Lumberjacks earn experience chopping logs. Carry 16 logs."
	]
	"quest.73292E754A800B8D.quest_subtitle": "Job starter"
	"quest.73292E754A800B8D.title": "Lumberjack"
	"quest.74B908B7033E7344.quest_desc": [
		"An Eye of Curse leads to a prison buried in snow. Craft one and throw it."
	]
	"quest.74B908B7033E7344.quest_subtitle": "Side task"
	"quest.74B908B7033E7344.title": "Eye of the Frost"
	"quest.76FFB30A032160C1.quest_desc": [
		"Something huge sleeps in the snowfields and on the ice spikes: the &bFrostmaw&r. Wake it and it breathes ice."
		"Optional. Everyone nearby at the kill earns a Rimefang Tusk."
	]
	"quest.76FFB30A032160C1.quest_subtitle": "Optional boss"
	"quest.76FFB30A032160C1.title": "Rimefang"
	"quest.785E70544950B7A5.quest_desc": [
		"Caravan guards tell of a pyramid that swallows the sun. Ask around, and someone sketches you a map."
		""
		"&7Reward: a map marking the Cursed Pyramid.&r"
	]
	"quest.785E70544950B7A5.quest_subtitle": "Map"
	"quest.785E70544950B7A5.title": "Whispers of Sand"
	"quest.7920CBCE701DE238.quest_desc": [
		"An Eye of Flame shows the way to the burning arena. Craft one."
	]
	"quest.7920CBCE701DE238.quest_subtitle": "Side task"
	"quest.7920CBCE701DE238.title": "Eye of Flame"
	"quest.7921983A422C6876.quest_desc": [
		"Fishermen earn experience for every catch. Catch a fish."
	]
	"quest.7921983A422C6876.quest_subtitle": "Job starter"
	"quest.7921983A422C6876.title": "Fisherman"
	"quest.7990F5145F92D1AA.quest_desc": [
		"Hunters are skinners and leatherworkers. They earn experience for every hide, bone and monster part their kills drop (and find more of them as they level), for hunting animals and for crafting leather goods. Bring in 8 leather."
	]
	"quest.7990F5145F92D1AA.quest_subtitle": "Job starter"
	"quest.7990F5145F92D1AA.title": "Hunter"
	"quest.7AD6EC34B35830B0.quest_desc": [
		"Defeat the &dAmethyst Crab&r. Everyone nearby at the kill earns a Geode Claw for this quest."
		"The claw raises your world tier to &eVenture&r: monsters wear more armor, rare monsters start to roam, and gear drops in iron and better rarities."
		""
		"&7Reward: a map marking a great dungeon of the Wildlands.&r"
	]
	"quest.7AD6EC34B35830B0.quest_subtitle": "Boss"
	"quest.7AD6EC34B35830B0.title": "Shell Shock"
	"quest.7ADADD9D86E83E50.quest_desc": [
		"Diamond gear is the next step. Bring back a handful."
	]
	"quest.7ADADD9D86E83E50.quest_subtitle": "Side task"
	"quest.7ADADD9D86E83E50.title": "Glittering Hoard"
	"quest.7DC8CDF63FD9011E.quest_desc": [
		"Optional raid. Bring three wither skeleton skulls and soul sand, and pick a place you do not mind losing."
	]
	"quest.7DC8CDF63FD9011E.quest_subtitle": "Optional raid"
	"quest.7DC8CDF63FD9011E.title": "Call of the Wither"
	"quest.7EC7FF658A0626F1.quest_desc": [
		"Piglin brutes do not care about your gold. Show them what you learned up top."
	]
	"quest.7EC7FF658A0626F1.title": "Brute Force"
	"quest.7F3ACDC21971B67E.quest_desc": [
		"Build a &6Cooking Pot&r and set it on a campfire or stove. Pot meals feed more and give the whole group buffs:"
		"- &aNourishment&r: your hunger stops dropping for a while."
		"- &aComfort&r: you keep healing however hungry you are."
		"Wild cabbages, tomatoes, onions and rice grow out in the world: break them for seeds. Hover over any food to see how much it restores."
	]
	"quest.7F3ACDC21971B67E.quest_subtitle": "Cooking (Farmer's Delight)"
	"quest.7F3ACDC21971B67E.title": "A Feast for the Party"
