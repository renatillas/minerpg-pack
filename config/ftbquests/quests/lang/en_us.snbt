	"quest.56FD8D6AAF4752E8.title": "Netherite Berserker Armor"
	"quest.57ABBFDC4552D08D.quest_desc": [
		"Every Rogue walks the same road: a weapon, then a full set of armor, each tier stronger than the last."
		"This row follows it from your first steel to the armor of legends."
		""
		"Each step can be &ocrafted&r, &obought&r or &olooted&r, and says how. Gear you already own counts as soon as the step opens."
	]
	"quest.57ABBFDC4552D08D.quest_subtitle": "Your class, step by step"
	"quest.57ABBFDC4552D08D.title": "The Rogue's Path"
	"quest.57F810F9EBD01932.quest_desc": [
		"Get a Wind Wand or Staff."
		""
		"&6Craft&r: Enchanter level 10, or any friend who is one."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.57F810F9EBD01932.quest_subtitle": "Tier 2 weapon"
	"quest.57F810F9EBD01932.title": "A Diamond Edge"
