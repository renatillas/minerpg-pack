	"quest.589173AB0C869B9F.title": "A Diamond Edge"
	"quest.5912FE33E4E2C70E.quest_desc": [
		"Miners earn experience breaking stone and ores. Mine 16 coal."
	]
	"quest.5912FE33E4E2C70E.quest_subtitle": "Job starter"
	"quest.5912FE33E4E2C70E.title": "Miner"
	"quest.5981EE879EE49344.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a healing staff made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.5981EE879EE49344.quest_subtitle": "Optional: boss-only weapon"
	"quest.5981EE879EE49344.title": "A Legend in Hand"
	"quest.5A29FB8E07307813.quest_desc": [
		"A ring of fire where a fallen knight still waits for challengers."
	]
	"quest.5A29FB8E07307813.title": "The Burning Arena"
	"quest.5A678F41280A7521.quest_desc": [
		"Deep in the Nether, ancient debris resists even lava. Dig some up."
	]
	"quest.5A678F41280A7521.title": "Ancient Debris"
	"quest.5B1A567C94A344A2.quest_desc": [
		"Wear or carry all four pieces of the &eWizard Robes&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Buy&r: the Wizard Merchant in the Wizard Tower may have it in stock."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.5B1A567C94A344A2.quest_subtitle": "Tier 1 armor"
	"quest.5B1A567C94A344A2.title": "Wizard Robes"
	"quest.5C9A512AF929AB58.quest_desc": [
		"The endgame set of every Water Mage: the &dOcean Robes&r."
		"At a smithing table, upgrade each Aqua Robes piece (diamond or netherite) with a &dWarden's Lost Crystal&r."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only an Enchanter of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.5C9A512AF929AB58.quest_subtitle": "Endgame armor"
	"quest.5C9A512AF929AB58.title": "The Armory"
	"quest.5D0D3E3C2B3C0A65.quest_desc": [
		"Press J and join up to three jobs. Each grows from its own work and pays a &6Gold Coin&r every level."
		"Three jobs is the most anyone can hold. To swap one, type &e/leavejob <job>&r: it costs 5 gold and deletes that job's level and power-ups for good. Buy power-ups in the same menu with the &6coins&r you carry. Coins also come from quests, chests and bosses."
		"The quests below show one way into each job."
	]
	"quest.5D0D3E3C2B3C0A65.quest_subtitle": "Jobs menu (J)"
	"quest.5D0D3E3C2B3C0A65.title": "Pick Your Trades"
	"quest.5DDDF61746F073A3.quest_desc": [
		"Nether wart grows in fortress gardens. Every real potion starts with it."
	]
	"quest.5DDDF61746F073A3.quest_subtitle": "Side task"
	"quest.5DDDF61746F073A3.title": "Wart and All"
