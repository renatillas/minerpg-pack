		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.391BEC2F41605019.quest_subtitle": "Tier 1 armor"
	"quest.391BEC2F41605019.title": "Elemental Apprentice Robes"
	"quest.3976D3F96227D68F.quest_desc": [
		"Gear in this world is more than its name. Every magic item rolls &obonuses&r (affixes), can hold &ogems&r, and can be broken down, reforged and fine-tuned."
		"Enchanting reaches far past level 30 once the right shelves stand around the table."
		""
		"This tab walks through both. Rarity and world tiers are in Getting Started."
	]
	"quest.3976D3F96227D68F.quest_subtitle": "Apotheosis, step by step"
	"quest.3976D3F96227D68F.title": "The Forge and the Library"
	"quest.39BC546692614563.quest_desc": [
		"Get an iron Berserker Axe."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.39BC546692614563.quest_subtitle": "Tier 1 weapon"
	"quest.39BC546692614563.title": "First Steel"
	"quest.39E4EF6895083D0C.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a instrument, rapier or harp crossbow made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.39E4EF6895083D0C.quest_subtitle": "Optional: boss-only weapon"
	"quest.39E4EF6895083D0C.title": "A Legend in Hand"
	"quest.3A6C127DAF675E05.quest_desc": [
		"A &6Gem Cutting Table&r combines gems (and gem dust) into a gem of higher purity. Higher purity, bigger bonuses."
		"Jewelers earn job experience cutting gems."
	]
	"quest.3A6C127DAF675E05.quest_subtitle": "Raise gem purity"
	"quest.3A6C127DAF675E05.title": "The Gem Cutter"
	"quest.3B976CE5D73E5FC0.quest_desc": [
		"Wear or carry all four pieces of the &eWizard Robes&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Buy&r: the Wizard Merchant in the Wizard Tower may have it in stock."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.3B976CE5D73E5FC0.quest_subtitle": "Tier 1 armor"
	"quest.3B976CE5D73E5FC0.title": "Wizard Robes"
	"quest.3CC5C2E540AFC999.quest_desc": [
		"Sailors swear a ship floats on the deep ocean with no wind in its sails. &9Nerakyss, the Kraken&r holds it, and its crew still guards the deck."
		"Optional. Everyone nearby at the kill earns a Abyssal Ink."
	]
	"quest.3CC5C2E540AFC999.quest_subtitle": "Optional boss"
	"quest.3CC5C2E540AFC999.title": "The Drowned Deck"
	"quest.3DFB025E3BBA5CDC.quest_desc": [
		"Defeat &4The Harbinger&r, the factory's iron herald."
		"Everyone nearby at the kill receives a &6Nether Sigil&r: use it on an obsidian frame to open the way to the Nether."
		"The sigil raises your world tier to &eAscent&r. Your reward includes netherite upgrade templates for the next tier and an &dAscension point&r: your first Transformation."
	]
	"quest.3DFB025E3BBA5CDC.quest_subtitle": "Chapter boss"
	"quest.3DFB025E3BBA5CDC.title": "The Harbinger"
	"quest.3E7B599CAC455CBF.quest_desc": [
		"A pyramid half-buried in desert sand, its door sealed with old curses."
	]
	"quest.3E7B599CAC455CBF.quest_subtitle": "Wildlands"
	"quest.3E7B599CAC455CBF.title": "The Cursed Pyramid"
	"quest.3F03244BAA9EF57E.quest_desc": [
		"Wear or carry all four pieces of the &eNetherite Prior Vestments&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Enchanter level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
	]
	"quest.3F03244BAA9EF57E.quest_subtitle": "Tier 3 armor"
	"quest.3F03244BAA9EF57E.title": "Netherite Prior Vestments"
	"quest.3F043D30988BC476.quest_desc": [
		"Press H for the Party HUD: invite your friends and keep their health in sight."
		"Your spells and swings never hurt each other, and kills near a friend teach you both. Heals and buffs reach every player, party or not."
		"In the Members tab, right-click each friend and add them to favorites to see their health frames."
		"Every boss is built for a full party of four. Alone, you will not win. Bring your friends."
		"Your quest book stays your own. When a boss falls, everyone nearby gets their own trophy or key."
	]
	"quest.3F043D30988BC476.quest_subtitle": "Party HUD (H)"
	"quest.3F043D30988BC476.title": "Better Together"
	"quest.3F2D9F92D902836B.quest_desc": [
		"A guard house with weapon racks. The Arms Dealer sells daggers, sickles, axes and armor for Rogues and Warriors."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.3F2D9F92D902836B.quest_subtitle": "Class building"
	"quest.3F2D9F92D902836B.title": "The Barracks"
	"quest.4002DA8DFCA3AC1A.quest_desc": [
		"Masked Umvuthana guard a grove in the savanna. Their chief, &6Umvuthi, the Sunbird&r, calls down sunfire and heals behind his followers."
		"Optional. Everyone nearby at the kill earns a Sunbird Plume."
	]
	"quest.4002DA8DFCA3AC1A.quest_subtitle": "Optional boss"
	"quest.4002DA8DFCA3AC1A.title": "The Sunbird's Court"
	"quest.4006A822FCE741F9.quest_desc": [
		"A fortress of black ice where something was locked away on purpose."
	]
	"quest.4006A822FCE741F9.quest_subtitle": "Wildlands"
	"quest.4006A822FCE741F9.title": "The Frosted Prison"
	"quest.401EC80945F55D97.quest_desc": [
		"A sealed arena in the Nether keeps its gates shut. Inside waits &5Helvar, the Underworld Knight&r. Win the key in its halls first."
		"Optional. Everyone nearby at the kill earns a Oathbreaker Seal."
	]
	"quest.401EC80945F55D97.quest_subtitle": "Optional boss"
	"quest.401EC80945F55D97.title": "The Oathsworn"
	"quest.404575A89AD631AE.quest_desc": [
		"An Eye of Monstrous leads to the soul blacksmith's forge. Craft one."
	]
	"quest.404575A89AD631AE.quest_subtitle": "Side task"
	"quest.404575A89AD631AE.title": "Eye of Fury"
	"quest.40678BD3902A909A.quest_desc": [
		"Reach &6level 20&r in any of your jobs."
		"At level 20, Smiths, Hunters and Enchanters make diamond class gear; Smiths reforge to Epic, Enchanters make the upgraded hell and sea shelves, Jewelers diamond and emerald jewelry, Cooks feasts, Explorers waystones and Great Dungeon Survey Maps, and Alchemists brew Lingering potions."
		"&7Checked when the job levels up.&r"
	]
	"quest.40678BD3902A909A.quest_subtitle": "Job milestone"
	"quest.40678BD3902A909A.title": "Expert"
	"quest.409FB0BE8F2205F1.quest_desc": [
		"Every kill teaches you something. Press N and spend your first talent point."
		"Friends within 200 blocks learn from your kills too."
		"Kills earn up to 18 points. 4 more come from the great chapter bosses."
	]
	"quest.409FB0BE8F2205F1.quest_subtitle": "Spend a talent point"
	"quest.409FB0BE8F2205F1.title": "A Point to Spend"
	"quest.4104BDA8E9E7FE69.quest_desc": [
		"Get an iron Rapier, a Lute or a Harp Crossbow."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Buy&r: the Luthier in the Bard's pub may have it in stock."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.4104BDA8E9E7FE69.quest_subtitle": "Tier 1 weapon"
	"quest.4104BDA8E9E7FE69.title": "First Steel"
	"quest.411A2262ED7F5B5C.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a longbow made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.411A2262ED7F5B5C.quest_subtitle": "Optional: boss-only weapon"
	"quest.411A2262ED7F5B5C.title": "A Legend in Hand"
	"quest.4123E323E910791A.quest_desc": [
		"Every Deadeye walks the same road: a weapon, then a full set of armor, each tier stronger than the last."
		"This row follows it from your first steel to the armor of legends."
		""
		"Each step can be &ocrafted&r, &obought&r or &olooted&r, and says how. Gear you already own counts as soon as the step opens."
	]
	"quest.4123E323E910791A.quest_subtitle": "Your class, step by step"
	"quest.4123E323E910791A.title": "The Deadeye's Path"
	"quest.41299363454A86A6.quest_desc": [
		"Wear or carry all four pieces of the &eBerserker Armor&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: Smith level 10, or any friend who is one."
		"&6Buy&r: the Arms Dealer in the Barracks may have it in stock."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
