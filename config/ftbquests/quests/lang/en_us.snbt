	]
	"quest.3432529E4CA45247.quest_subtitle": "Tier 3 weapon"
	"quest.3432529E4CA45247.title": "Forged in Netherite"
	"quest.34BEFE9F912CD9C5.quest_desc": [
		"Deep under the Hearthlands, a sealed chamber holds a suit of armor that is not empty: the &7Ferrous Wroughtnaut&r."
		"Its armor turns most blows. Dodge the axe, then strike its back while it recovers."
		"Optional. Everyone nearby at the kill earns a Wrought Rivet."
	]
	"quest.34BEFE9F912CD9C5.quest_subtitle": "Optional boss"
	"quest.34BEFE9F912CD9C5.title": "The Iron Sentinel"
	"quest.3611174B7DE1131E.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a axe or sword made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.3611174B7DE1131E.quest_subtitle": "Optional: boss-only weapon"
	"quest.3611174B7DE1131E.title": "A Legend in Hand"
	"quest.364D117B6870A5B2.quest_desc": [
		"Two endgame sets answer a Frost Wizard. Either one completes this step:"
		"- &dGlacier Robes&r: Frost Robes piece + &dVanquisher's Lost Crystal&r"
		"- &dRimeweave Robes&r: Frost Robes piece + &dVanquisher's Forgotten Crystal&r"
		"Upgrade each piece at a smithing table (diamond or netherite pieces both work)."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only an Enchanter of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.364D117B6870A5B2.quest_subtitle": "Endgame armor"
	"quest.364D117B6870A5B2.title": "The Armory"
	"quest.3666625E717DFC13.quest_desc": [
		"Summon and destroy &8the Wither&r with your whole group. Everyone nearby earns an Ashen Skull Shard, and an &dAscension point&r to empower your Ultimate."
	]
	"quest.3666625E717DFC13.quest_subtitle": "Optional raid"
	"quest.3666625E717DFC13.title": "The Wither"
	"quest.36E9B005B8159543.quest_desc": [
		"Wear or carry all four pieces of the &ePrior Vestments&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: Enchanter level 10, or any friend who is one."
		"&6Buy&r: the Monk in the Sanctuary may have it in stock."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.36E9B005B8159543.quest_subtitle": "Tier 2 armor"
	"quest.36E9B005B8159543.title": "Prior Vestments"
	"quest.38D3B1761DE5579B.quest_desc": [
		"Villages with a &6Jeweler&r trade gems, rings and necklaces. Gem veins hide underground too."
		"Or take up the &3Jeweler&r job (J) and make them yourself."
	]
	"quest.38D3B1761DE5579B.quest_subtitle": "Rings and necklaces"
	"quest.38D3B1761DE5579B.title": "The Jeweler"
	"quest.39026CB0D8738A17.quest_desc": [
		"Get netherite Knuckles."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Smith level 20)."
