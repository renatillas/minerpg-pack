	"file.0000000000000001.title": "minerpg"
	"quest.10318286AE389F9C.quest_desc": [
		"Get a diamond Berserker Axe."
		""
		"&6Craft&r: Smith level 10, or any friend who is one."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.10318286AE389F9C.quest_subtitle": "Tier 2 weapon"
	"quest.10318286AE389F9C.title": "A Diamond Edge"
	"quest.1079047B48B1C2FE.quest_desc": [
		"The endgame set of every Forcemaster: the &dBillporon Suit&r."
		"At a smithing table, upgrade each Phasleb Suit piece (diamond or netherite) with a &dAscetic's Lost Crystal&r."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only a Smith of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.1079047B48B1C2FE.quest_subtitle": "Endgame armor"
	"quest.1079047B48B1C2FE.title": "The Armory"
	"quest.10865476522F9C8E.quest_desc": [
		"Every Fire Wizard walks the same road: a weapon, then a full set of armor, each tier stronger than the last."
		"This row follows it from your first steel to the armor of legends."
		""
		"Each step can be &ocrafted&r, &obought&r or &olooted&r, and says how. Gear you already own counts as soon as the step opens."
	]
	"quest.10865476522F9C8E.quest_subtitle": "Your class, step by step"
	"quest.10865476522F9C8E.title": "The Fire Wizard's Path"
	"quest.1093BA38C50D1EA8.quest_desc": [
		"Wear or carry all four pieces of the &eCrusader Armor&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: Smith level 10, or any friend who is one."
		"&6Buy&r: the Monk in the Sanctuary may have it in stock."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.1093BA38C50D1EA8.quest_subtitle": "Tier 2 armor"
	"quest.1093BA38C50D1EA8.title": "Crusader Armor"
	"quest.10E969E37FE81A40.quest_desc": [
		"A &6Reforging Table&r rerolls the bonuses of a piece of gear, and can raise its rarity. It costs rarity materials and gem dust."
		"Reforging to &9Rare&r needs a Smith of level 10, &5Epic&r 20, &6Mythic&r 30."
	]
	"quest.10E969E37FE81A40.quest_subtitle": "Reroll and upgrade gear"
	"quest.10E969E37FE81A40.title": "A Second Forging"
	"quest.11F4C25FDB99D364.quest_desc": [
		"Never take a blow you can roll away from. R, unless you changed it."
		"Mid-roll, nothing can touch you. Rolls recharge over time."
	]
	"quest.11F4C25FDB99D364.quest_subtitle": "Dodge roll"
	"quest.11F4C25FDB99D364.title": "Light on Your Feet"
	"quest.130AD4B6ADB6DAEF.quest_desc": [
		"&dGems&r drop from monsters and chests. Each one gives a different bonus depending on where it sits: weapon, armor, or anything else."
		"Hover over a gem to read all its bonuses."
	]
	"quest.130AD4B6ADB6DAEF.quest_subtitle": "Find a gem"
	"quest.130AD4B6ADB6DAEF.title": "Stones of Power"
	"quest.135B76B18CB805D2.quest_desc": [
		"Wear or carry all four pieces of the &eNetherite Fire Robes&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Enchanter level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
	]
	"quest.135B76B18CB805D2.quest_subtitle": "Tier 3 armor"
