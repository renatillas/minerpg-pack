	"quest.50C778B21D914B33.title": "Echoes Below"
	"quest.50D978A09E750B13.quest_desc": [
		"Reach &6level 10&r in any of your jobs."
		"At level 10, Smiths, Hunters and Enchanters make tier 1 class gear of their kind, Enchanters also the Hellshelf and Seashelf, Jewelers gold and gem jewelry, Cooks plated meals, Explorers scrolls and Crypt Survey Maps, and Alchemists brew Strong and Long potions."
		"&7Checked when the job levels up.&r"
	]
	"quest.50D978A09E750B13.quest_subtitle": "Job milestone"
	"quest.50D978A09E750B13.title": "Journeyman"
	"quest.516F384D63226205.quest_desc": [
		"A small white chapel. The Monk sells holy weapons, armor and healing runes for Paladins and Priests."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.516F384D63226205.quest_subtitle": "Class building"
	"quest.516F384D63226205.title": "The Sanctuary"
	"quest.5263DB62DE2D45A9.quest_desc": [
		"If you are downed, a friend can pick you up. If you truly die, nothing is lost: your items, armor, trinkets, backpack and experience wait in a &6grave&r. The chat says where, and you respawn with a compass to it."
		"Only you can open it for 15 minutes; after that a friend may collect it for you."
	]
	"quest.5263DB62DE2D45A9.quest_subtitle": "Graves"
	"quest.5263DB62DE2D45A9.title": "If You Fall"
	"quest.533BD5F53E1AE9FC.quest_desc": [
		"Get a netherite Claymore, Great Hammer or Mace."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Smith level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
	]
	"quest.533BD5F53E1AE9FC.quest_subtitle": "Tier 3 weapon"
	"quest.533BD5F53E1AE9FC.title": "Forged in Netherite"
	"quest.5342B109738F0034.quest_desc": [
		"Fishermen avoid one stretch of sea: towers stand under the water there. They marked it for you."
		""
		"&7Reward: a map marking the Sunken City.&r"
	]
	"quest.5342B109738F0034.quest_subtitle": "Map"
	"quest.5342B109738F0034.title": "Whispers of the Tide"
	"quest.540E7EDF83A1ADBE.quest_desc": [
		"Make something only a trained hand can make: class gear as a Smith, Hunter or Enchanter, an enchanting shelf as an Enchanter, gem jewelry or a Socket Mount as a Jeweler, a plated meal or a feast as a Cook, a scroll or a Survey Map as an Explorer, or a Strong, Long, Splash or Lingering potion as an Alchemist."
		"Then hand it to a party member who could not make it. That is what trades are for."
	]
	"quest.540E7EDF83A1ADBE.quest_subtitle": "Job milestone"
	"quest.540E7EDF83A1ADBE.title": "Made for a Friend"
	"quest.54311A9745EC4D9E.quest_desc": [
		"A &6Potion Charm&r holds a potion and gives its effect while it sits in your inventory, until it wears out."
		"Alchemists earn job experience making them."
	]
	"quest.54311A9745EC4D9E.quest_subtitle": "Effects that last"
	"quest.54311A9745EC4D9E.title": "Bottled Luck"
	"quest.54854E6D0A86E2C6.quest_desc": [
		"The &cFrontier&r is the extreme: frozen peaks, ice spikes, the deep dark and the deep ocean. The hardest lands of this world."
		"Beat at least one Wildlands boss, then find an ancient city in the deep dark."
		""
		"&7Reward: a map marking the Ancient Factory.&r"
	]
	"quest.54854E6D0A86E2C6.quest_subtitle": "Frontier"
	"quest.54854E6D0A86E2C6.title": "The Frontier"
	"quest.551B4EC7917C7B74.quest_desc": [
		"Defeat the &6Netherite Monstrosity&r. Beating it earns you an &dAscension point&r."
	]
	"quest.551B4EC7917C7B74.quest_subtitle": "Boss"
	"quest.551B4EC7917C7B74.title": "Forged in Fury"
	"quest.5542D87C1BF085E8.quest_desc": [
		"A lively pub. The Luthier sells lutes and other instruments for Bards."
		""
		"Find the building in a village and trade once with its merchant."
	]
	"quest.5542D87C1BF085E8.quest_subtitle": "Class building"
	"quest.5542D87C1BF085E8.title": "The Bard's Pub"
	"quest.558D7ACBE84CC796.quest_desc": [
		"Blazes guard the fortress. Their rods feed brewing stands and Eyes of Ender alike."
	]
	"quest.558D7ACBE84CC796.title": "Burning Wardens"
	"quest.55F345EDFB271EE0.quest_desc": [
		"Get a netherite Rapid or Heavy Crossbow."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Hunter level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
	]
	"quest.55F345EDFB271EE0.quest_subtitle": "Tier 3 weapon"
	"quest.55F345EDFB271EE0.title": "Forged in Netherite"
	"quest.56FD8D6AAF4752E8.quest_desc": [
		"Wear or carry all four pieces of the &eNetherite Berserker Armor&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Smith level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
