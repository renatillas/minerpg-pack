	"quest.4B73FD0ECB5CA15E.quest_desc": [
		"Two endgame sets answer a Priest. Either one completes this step:"
		"- &dAvatar Vestments&r: Prior Vestments piece + &dRedeemer's Lost Crystal&r"
		"- &dAbsolution Vestments&r: Prior Vestments piece + &dRedeemer's Forgotten Crystal&r"
		"Upgrade each piece at a smithing table (diamond or netherite pieces both work)."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only an Enchanter of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.4B73FD0ECB5CA15E.quest_subtitle": "Endgame armor"
	"quest.4B73FD0ECB5CA15E.title": "The Armory"
	"quest.4BE568A5179E7FC1.quest_desc": [
		"Some monsters are &celites&r: a title over their heads and special powers, from shields to reflecting damage. They hit harder and drop better loot."
		"Fight them with your party, or not at all."
	]
	"quest.4BE568A5179E7FC1.quest_subtitle": "Champions"
