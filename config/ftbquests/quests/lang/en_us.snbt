	"quest.65B46437DDA1FF65.title": "The Earth Mage's Path"
	"quest.67BEF13204319F77.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a heavy crossbow made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.67BEF13204319F77.quest_subtitle": "Optional: boss-only weapon"
	"quest.67BEF13204319F77.title": "A Legend in Hand"
	"quest.67CB5231623A0129.quest_desc": [
		"The endgame set of every Earth Mage: the &dMountain Robes&r."
		"At a smithing table, upgrade each Terra Robes piece (diamond or netherite) with a &dWarden's Lost Crystal&r."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only an Enchanter of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.67CB5231623A0129.quest_subtitle": "Endgame armor"
	"quest.67CB5231623A0129.title": "The Armory"
	"quest.68A41439B84F7D37.quest_desc": [
		"The endgame set of every Wind Mage: the &dHurricane Robes&r."
		"At a smithing table, upgrade each Wind Robes piece (diamond or netherite) with a &dWarden's Lost Crystal&r."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only an Enchanter of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.68A41439B84F7D37.quest_subtitle": "Endgame armor"
	"quest.68A41439B84F7D37.title": "The Armory"
	"quest.68A6A185A12ED4E6.quest_desc": [
		"Among the great graveyards stands an altar, and on it waits the &7Corrupted Champion&r, a hero who would not stay buried."
		"Optional. Everyone nearby at the kill earns a Champion's Tarnished Crest."
	]
	"quest.68A6A185A12ED4E6.quest_subtitle": "Optional boss"
	"quest.68A6A185A12ED4E6.title": "The Fallen Hero"
	"quest.68ADD28694A0A17E.quest_desc": [
		"An Eye of Mech points to the ancient factory. Craft one and follow it."
	]
	"quest.68ADD28694A0A17E.quest_subtitle": "Side task"
	"quest.68ADD28694A0A17E.title": "Eye of Iron"
	"quest.691EA646A3AD516D.quest_desc": [
		"Good iron makes good gear. Stock up for your first upgrades."
	]
	"quest.691EA646A3AD516D.quest_subtitle": "Side task"
	"quest.691EA646A3AD516D.title": "Ironclad"
	"quest.6954E43EA41454B7.quest_desc": [
		"Cooks earn experience for every meal: stews and soups from the cooking pot, plated meals and feasts at the table. Plated meals need Cook 10, feasts Cook 20. Cook any meal in a cooking pot."
	]
	"quest.6954E43EA41454B7.quest_subtitle": "Job starter"
	"quest.6954E43EA41454B7.title": "Cook"
	"quest.6AF19D8A355966AA.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a axe, glaive or longsword made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.6AF19D8A355966AA.quest_subtitle": "Optional: boss-only weapon"
	"quest.6AF19D8A355966AA.title": "A Legend in Hand"
	"quest.6AF27B410258165F.quest_desc": [
		"Wear or carry all four pieces of the &eElemental Apprentice Robes&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.6AF27B410258165F.quest_subtitle": "Tier 1 armor"
	"quest.6AF27B410258165F.title": "Elemental Apprentice Robes"
	"quest.6B54BC29B3B37827.quest_desc": [
		"Defeat the &5Ender Guardian&r, last warden of the citadel. Beating it earns you an &dAscension point&r: your Ultimate."
		"With both the Citadel Keystone and the Dragonscale, your world tier rises to &ePinnacle&r."
	]
	"quest.6B54BC29B3B37827.quest_subtitle": "Chapter boss"
	"quest.6B54BC29B3B37827.title": "Guardian of the Void"
	"quest.6C38F2193F5F97B4.quest_desc": [
		"Get a Frost Wand or Staff."
		""
		"&6Craft&r: Enchanter level 10, or any friend who is one."
		"&6Buy&r: the Wizard Merchant in the Wizard Tower may have it in stock."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.6C38F2193F5F97B4.quest_subtitle": "Tier 2 weapon"
	"quest.6C38F2193F5F97B4.title": "A Diamond Edge"
	"quest.6C811E0AFCFDD19B.quest_desc": [
		"Enchanters earn experience at the enchanting table and the Spell Binding Table. Enchant any item."
	]
	"quest.6C811E0AFCFDD19B.quest_subtitle": "Job starter"
	"quest.6C811E0AFCFDD19B.title": "Enchanter"
	"quest.6C8A4B797B816007.quest_desc": [
		"A &6Cutting Board&r slices with a knife; a &6Skillet&r cooks over heat. Together with the cooking pot they make every Farmer's Delight meal."
		"Cooks earn job experience for every meal. Plated meals need a Cook of level 10, feasts a Cook of level 20."
	]
	"quest.6C8A4B797B816007.quest_subtitle": "Farmer's Delight"
	"quest.6C8A4B797B816007.title": "A Proper Kitchen"
	"quest.6D97E040B04E5B09.quest_desc": [
		"Wear or carry all four pieces of the &eNetherite Bowman Armor&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Hunter level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
	]
	"quest.6D97E040B04E5B09.quest_subtitle": "Tier 3 armor"
	"quest.6D97E040B04E5B09.title": "Netherite Bowman Armor"
	"quest.6DA8F6337A1AD59A.quest_desc": [
		"Back in the Overworld, a tower on the frozen peaks belongs to &bthe Night Lich&r. Slay enough of the dead near it and it comes."
		"Optional. Everyone nearby at the kill earns a Phylactery Shard."
	]
	"quest.6DA8F6337A1AD59A.quest_subtitle": "Optional boss"
	"quest.6DA8F6337A1AD59A.title": "The Night Lich"
	"quest.6E1A5C775EB148AF.quest_desc": [
		"Get a Wizard Staff."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Buy&r: the Wizard Merchant in the Wizard Tower may have it in stock."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.6E1A5C775EB148AF.quest_subtitle": "Tier 1 weapon"
	"quest.6E1A5C775EB148AF.title": "First Steel"
	"quest.710AD64B960DC726.quest_desc": [
		"The &6Wildlands&r are the harsh lands: deserts, jungles, swamps, taigas, dark forests and open sea. Big dungeons and ruins hide there, and monsters hit harder."
		"Explore one of the great dungeons of the wild."
	]
	"quest.710AD64B960DC726.quest_subtitle": "Wildlands"
	"quest.710AD64B960DC726.title": "Into the Wildlands"
	"quest.7117B5E8E653E9E8.quest_desc": [
		"Wear or carry all four pieces of the &eWind Robes&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: Enchanter level 10, or any friend who is one."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.7117B5E8E653E9E8.quest_subtitle": "Tier 2 armor"
	"quest.7117B5E8E653E9E8.title": "Wind Robes"
	"quest.71222F68234D4EB9.quest_desc": [
		"Get a netherite Frost Wand or Staff."
		""
		"&6Craft&r: at a smithing table, the diamond piece + a netherite ingot + a netherite upgrade template (Enchanter level 20)."
		"&6Loot&r: the Harbinger and the Netherite Monstrosity."
	]
	"quest.71222F68234D4EB9.quest_subtitle": "Tier 3 weapon"
	"quest.71222F68234D4EB9.title": "Forged in Netherite"
	"quest.7140D2F2C89AA174.quest_desc": [
		"On the outer islands of the End a pillar of obsidian moves when no one watches: &5the Obsidilith&r."
		"Optional. Everyone nearby at the kill earns a Obsidian Heartstone."
	]
	"quest.7140D2F2C89AA174.quest_subtitle": "Optional boss"
	"quest.7140D2F2C89AA174.title": "The Black Pillar"
	"quest.71ED147E96C3CDB4.quest_desc": [
		"Defeat &cIgnis&r, the burning champion."
		"Everyone nearby at the kill receives a &dVoid Shard&r. Eyes of Ender need it, and it is never used up."
		"The shard raises your world tier to &eSummit&r. Your reward includes an &dAscension point&r and a book of &bSpell Infinity&r: put it on your weapon at an anvil and your spells stop using runes."
	]
	"quest.71ED147E96C3CDB4.quest_subtitle": "Chapter boss"
	"quest.71ED147E96C3CDB4.title": "Ignis"
	"quest.7214FD69CAC0DE96.quest_desc": [
		"Your class's road appears here once you have chosen it: a weapon, then a full set of armor, tier after tier, up to the armor of legends."
		""
		"No class yet? &6Choose Your Calling&r in Getting Started. Bound a second class at a Spell Binding Table? Its road appears here too, a moment after the tome is in your bag or its slot."
	]
	"quest.7214FD69CAC0DE96.quest_subtitle": "Start here"
	"quest.7214FD69CAC0DE96.title": "Your Calling"
	"quest.744C9A9A39A3F946.quest_desc": [
		"Every Arcane Wizard walks the same road: a weapon, then a full set of armor, each tier stronger than the last."
		"This row follows it from your first steel to the armor of legends."
		""
		"Each step can be &ocrafted&r, &obought&r or &olooted&r, and says how. Gear you already own counts as soon as the step opens."
	]
	"quest.744C9A9A39A3F946.quest_subtitle": "Your class, step by step"
	"quest.744C9A9A39A3F946.title": "The Arcane Wizard's Path"
	"quest.74B908B7033E7344.quest_desc": [
		"An Eye of Curse leads to a prison buried in snow. Craft one and throw it."
	]
	"quest.74B908B7033E7344.quest_subtitle": "Side task"
	"quest.74B908B7033E7344.title": "Eye of the Frost"
	"quest.75611B5C933FAFE7.quest_desc": [
		"Every Forcemaster walks the same road: a weapon, then a full set of armor, each tier stronger than the last."
		"This row follows it from your first steel to the armor of legends."
		""
		"Each step can be &ocrafted&r, &obought&r or &olooted&r, and says how. Gear you already own counts as soon as the step opens."
	]
	"quest.75611B5C933FAFE7.quest_subtitle": "Your class, step by step"
	"quest.75611B5C933FAFE7.title": "The Forcemaster's Path"
	"quest.76FFB30A032160C1.quest_desc": [
		"Something huge sleeps in the snowfields and on the ice spikes: the &bFrostmaw&r. Wake it and it breathes ice."
		"Optional. Everyone nearby at the kill earns a Rimefang Tusk."
	]
	"quest.76FFB30A032160C1.quest_subtitle": "Optional boss"
	"quest.76FFB30A032160C1.title": "Rimefang"
	"quest.77275F9ADF8F5E43.quest_desc": [
		"Get a Crossbow."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Buy&r: the Archery Artisan in the Archery Range may have it in stock."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.77275F9ADF8F5E43.quest_subtitle": "Tier 1 weapon"
	"quest.77275F9ADF8F5E43.title": "First Steel"
	"quest.785E70544950B7A5.quest_desc": [
		"Caravan guards tell of a pyramid that swallows the sun. Ask around, and someone sketches you a map."
		""
		"&7Reward: a map marking the Cursed Pyramid.&r"
	]
	"quest.785E70544950B7A5.quest_subtitle": "Map"
	"quest.785E70544950B7A5.title": "Whispers of Sand"
	"quest.7920CBCE701DE238.quest_desc": [
		"An Eye of Flame shows the way to the burning arena. Craft one."
	]
	"quest.7920CBCE701DE238.quest_subtitle": "Side task"
	"quest.7920CBCE701DE238.title": "Eye of Flame"
	"quest.7990F5145F92D1AA.quest_desc": [
		"Hunters are skinners and leatherworkers. They earn experience for every hide, bone and monster part their kills drop (and find more of them as they level), for hunting animals and for crafting leather goods. Bring in 8 leather."
	]
	"quest.7990F5145F92D1AA.quest_subtitle": "Job starter"
	"quest.7990F5145F92D1AA.title": "Hunter"
	"quest.7AD6EC34B35830B0.quest_desc": [
		"Defeat the &dAmethyst Crab&r. Everyone nearby at the kill earns a Geode Claw for this quest."
		"The claw raises your world tier to &eVenture&r: monsters wear more armor, rare monsters start to roam, and gear drops in iron and better rarities."
		""
		"&7Reward: a map marking a great dungeon of the Wildlands.&r"
	]
	"quest.7AD6EC34B35830B0.quest_subtitle": "Boss"
	"quest.7AD6EC34B35830B0.title": "Shell Shock"
	"quest.7ADADD9D86E83E50.quest_desc": [
		"Diamond gear is the next step. Bring back a handful."
	]
	"quest.7ADADD9D86E83E50.quest_subtitle": "Side task"
	"quest.7ADADD9D86E83E50.title": "Glittering Hoard"
	"quest.7B4169F3E37652A8.quest_desc": [
		"Wear or carry all four pieces of the &eOriene Suit&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: anyone can, at a crafting table."
		"&6Loot&r: Hearthlands chests, small dungeons and the Amethyst Crab."
	]
	"quest.7B4169F3E37652A8.quest_subtitle": "Tier 1 armor"
	"quest.7B4169F3E37652A8.title": "Oriene Suit"
	"quest.7C301FD6C811E316.quest_desc": [
		"&dRelics&r are trinkets with a single strong effect: heal on a kill, a burst of speed, a ward against death."
		"Most drop from bosses and deep dungeons."
	]
	"quest.7C301FD6C811E316.quest_subtitle": "Trinket slot"
	"quest.7C301FD6C811E316.title": "Relics"
	"quest.7D42ACC7E47654F3.quest_desc": [
		"You have beaten one of the great Wildlands bosses. Something in you answers."
		"Your reward is your first &dAscension point&r. Only bosses give them."
		"Open your talents (N) and the &dAscension&r tab: choose one of your class's two Fates. Each is a big gift with a real drawback, and the other one locks."
		"Rogue, Warrior, Priest, Paladin and Deadeye have Fates now; other classes keep their points until theirs arrive. The handbook has every Fate."
	]
	"quest.7D42ACC7E47654F3.quest_subtitle": "Ascension"
	"quest.7D42ACC7E47654F3.title": "Awaken Your Fate"
	"quest.7DC0800E7F0DC167.quest_desc": [
		"Explorers draw Survey Maps that lead the party to settlements, crypts, dungeons and boss lairs, and build the waystone network. They earn experience by exploring: each new biome, each village, crypt or dungeon they walk into, each new waystone and each map they fill in. Draw a Survey Map from a map and an emerald."
	]
	"quest.7DC0800E7F0DC167.quest_subtitle": "Job starter"
	"quest.7DC0800E7F0DC167.title": "Explorer"
	"quest.7DC8CDF63FD9011E.quest_desc": [
		"Optional raid. Bring three wither skeleton skulls and soul sand, and pick a place you do not mind losing."
	]
	"quest.7DC8CDF63FD9011E.quest_subtitle": "Optional raid"
	"quest.7DC8CDF63FD9011E.title": "Call of the Wither"
	"quest.7E34F5E08D7B282D.quest_desc": [
		"&cHellshelves&r (Nether bricks) and &bSeashelves&r (prismarine) are the first step past level 30."
		"Making them needs an &dEnchanter&r of level 10; their upgrades level 20."
	]
	"quest.7E34F5E08D7B282D.quest_subtitle": "Enchanter 10"
	"quest.7E34F5E08D7B282D.title": "Hell and Sea"
	"quest.7E6A8B47D8CA49CC.quest_desc": [
		"Two endgame sets answer a Fire Wizard. Either one completes this step:"
		"- &dScarlet Robes&r: Fire Robes piece + &dConqueror's Lost Crystal&r"
		"- &dSmouldering Robes&r: Fire Robes piece + &dConqueror's Forgotten Crystal&r"
		"Upgrade each piece at a smithing table (diamond or netherite pieces both work)."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only an Enchanter of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.7E6A8B47D8CA49CC.quest_subtitle": "Endgame armor"
	"quest.7E6A8B47D8CA49CC.title": "The Armory"
	"quest.7EC13CD969AF09D6.quest_desc": [
		"Wear or carry all four pieces of the &eDeadeye Armor&r: helmet, chest, legs and boots."
		""
		"&6Craft&r: Hunter level 10, or any friend who is one."
		"&6Buy&r: the Archery Artisan in the Archery Range may have it in stock."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.7EC13CD969AF09D6.quest_subtitle": "Tier 2 armor"
	"quest.7EC13CD969AF09D6.title": "Deadeye Armor"
	"quest.7EC7FF658A0626F1.quest_desc": [
		"Piglin brutes do not care about your gold. Show them what you learned up top."
	]
	"quest.7EC7FF658A0626F1.title": "Brute Force"
	"quest.7EEB99FFB405925A.quest_desc": [
		"No smith makes these. The &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r carry one-of-a-kind weapons; one of them may be a longbow or spear made for you."
		"Bring friends: these are the hardest fights in the world."
	]
	"quest.7EEB99FFB405925A.quest_subtitle": "Optional: boss-only weapon"
	"quest.7EEB99FFB405925A.title": "A Legend in Hand"
	"quest.7F12355C44326248.quest_desc": [
		"Get diamond Knuckles."
		""
		"&6Craft&r: Smith level 10, or any friend who is one."
		"&6Loot&r: Wildlands and Frontier dungeons, and the Ancient Remnant, Maledictus, the Leviathan and Scylla."
	]
	"quest.7F12355C44326248.quest_subtitle": "Tier 2 weapon"
	"quest.7F12355C44326248.title": "A Diamond Edge"
	"quest.7F3ACDC21971B67E.quest_desc": [
		"Build a &6Cooking Pot&r and set it on a campfire or stove. Pot meals feed more and give the whole group buffs:"
		"- &aNourishment&r: your hunger stops dropping for a while."
		"- &aComfort&r: you keep healing however hungry you are."
		"Wild cabbages, tomatoes, onions and rice grow out in the world: break them for seeds. Hover over any food to see how much it restores."
		"Anyone can cook in the pot. A &6Cook&r (J) earns job experience for it, and sometimes gets a second helping."
	]
	"quest.7F3ACDC21971B67E.quest_subtitle": "Cooking (Farmer's Delight)"
	"quest.7F3ACDC21971B67E.title": "A Feast for the Party"
	"quest.7F6EFC9E1B2A25C6.quest_desc": [
		"A tower burns on the plains and never falls. On top roosts &cAshlord, the Infernal Dragon&r."
		"Optional. Everyone nearby at the kill earns a Cinder Scale."
	]
	"quest.7F6EFC9E1B2A25C6.quest_subtitle": "Optional boss"
	"quest.7F6EFC9E1B2A25C6.title": "Embers on the Tower"
	"quest.7F77AC6E99CF3DA3.quest_desc": [
		"The &6Jeweler's Kit&r cuts the jeweler's gems (ruby, sapphire, jade, topaz, citrine, tanzanite) to fit into armor. Put a gem in and pick one of its four cuts: the cut decides the bonus."
		"Shadowy Tanzanite adds soul spell power, Fierce Ruby critical damage, the sapphires health and armor. Hover over each cut to compare."
		"Jewelers earn job experience for every gem they cut."
	]
	"quest.7F77AC6E99CF3DA3.quest_subtitle": "Gem cutting"
	"quest.7F77AC6E99CF3DA3.title": "Cut to Fit"
