	"quest.47192179145EF3AD.quest_desc": [
		"Piglins hoard gold in huge black fortresses. Find a bastion."
	]
	"quest.47192179145EF3AD.title": "Bastion of Gold"
	"quest.476ABDE74108C527.quest_desc": [
		"The endgame set of every Berserker: the &dNorse Warlord Suit&r."
		"At a smithing table, upgrade each Northling Suit piece (diamond or netherite) with a &dRavager's Lost Crystal&r."
		""
		"Every upgrade also takes an &dArmory template&r, copied at a crafting table with diamonds."
		"Crystals and templates drop from &cIgnis&r, the &5Ender Guardian&r, the &5Ender Dragon&r and the &8Wither&r."
		"Only a Smith of level 25 can do the upgrade; anyone can wear it."
	]
	"quest.476ABDE74108C527.quest_subtitle": "Endgame armor"
	"quest.476ABDE74108C527.title": "The Armory"
	"quest.47A7D524E4668C17.quest_desc": [
		"Tier upgrades (iron, gold, diamond, netherite) add rows of slots. Other upgrades add a crafting grid, a furnace, a magnet or auto-feeding."
	]
	"quest.47A7D524E4668C17.quest_subtitle": "Backpack upgrades"
	"quest.47A7D524E4668C17.title": "Room to Grow"
	"quest.47E3538B073BEA0C.quest_desc": [
		"Unroll the backpack's sleeping bag to sleep out in the wild, far from any bed."
	]
	"quest.47E3538B073BEA0C.quest_subtitle": "Sleeping bag"
	"quest.47E3538B073BEA0C.title": "Camp Anywhere"
	"quest.484F1A15221E6BFE.quest_desc": [
		"Tom's Storage turns a room of chests into one searchable window. Put an &6Inventory Connector&r touching your chests (or linked to them by cables) and a &6Storage Terminal&r next to it."
		"With a Wireless Terminal in your pocket, M opens it from nearby."
	]
	"quest.484F1A15221E6BFE.quest_subtitle": "Tom's Simple Storage"
	"quest.484F1A15221E6BFE.title": "One Window for Every Chest"
